# ══════════════════════════════════════════════
#  Digital Asset Marketplace — Environment File
#  Copy this to .env and fill in your values.
#  Never commit .env to version control.
# ══════════════════════════════════════════════

APP_NAME="My Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# ── Database ──────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=root
DB_PASSWORD=

# ── Queue ─────────────────────────────────────
# Use 'database' for simple setup, 'redis' for production
QUEUE_CONNECTION=database

# ── Cache ─────────────────────────────────────
CACHE_DRIVER=file
# CACHE_DRIVER=redis  ← production
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ── Session ───────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false   # ← set true in production (HTTPS required)
SESSION_SAME_SITE=lax

# ── Mail ──────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── UddoktaPay Payment Gateway ────────────────
# Official docs: https://uddoktapay.com/docs
# Use the SANDBOX URL for testing.
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com/api

# ── BulkSMSBD SMS Gateway ─────────────────────
# Official docs: https://bulksmsbd.net/api-documentation
# Set ENABLED=true only after testing with a real number.
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
BULKSMSBD_ENABLED=false
BULKSMSBD_API_URL=http://bulksmsbd.net/api/smsapi

# ── Broadcasting (Real-time Order Chat) ───────
# Set to 'reverb' for self-hosted or 'pusher' for Pusher Channels.
# Leave as 'null' to use 5-second polling fallback (no WebSocket dependency).
BROADCAST_DRIVER=null

# Laravel Reverb (self-hosted — recommended):
# Install: php artisan reverb:install
# Run:     php artisan reverb:start
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Pusher (alternative):
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=ap2

# ── Storage ───────────────────────────────────
FILESYSTEM_DISK=local
# Private disk is configured in config/filesystems.php — see README.

# ── Logging ───────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_LEVEL=warning  ← production
